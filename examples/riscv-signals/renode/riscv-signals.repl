ram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x10000

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac_zicsr_zifencei"
    timeProvider: clint
    hartId: 0
    IsHalted: true

plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0C000000
    0 -> cpu@11
    numberOfSources: 15
    numberOfContexts: 1

clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
    [0,1] -> cpu@[3,7]
    frequency: 10000000

riscvBundle: SystemC.RiscVBundle
    cpu: cpu
    interruptController: plic
    timer: clint
    bootAddress: 0x80000000
    numberOfInterrupts: 16
    nmiVectorAddress: 0x80000200
    nmiVectorLength: 1

signals: SystemC.SystemCRiscVSignalsUnit @ {
        sysbus new Bus.BusRangeRegistration { address: 0x90000000; size: 0x100000; cpu: cpu };
    }
    riscvBundles: [riscvBundle]
    address: "127.0.0.1"
    port: 4242
    timeSyncPeriodUS: 5000
