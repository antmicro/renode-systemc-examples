sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

cortexMBundle: SystemC.CortexMBundle
    cpu: cpu
    nvic: nvic
    dwt: dwt

signals: SystemC.SystemCCortexMSignalsUnit @ {
        sysbus new Bus.BusRangeRegistration { address: 0x10000000; size: 0xfffffff; cpu: cpu };
    }
    cortexMBundles: [cortexMBundle]
    address: "127.0.0.1"
    port: 4242
    timeSyncPeriodUS: 5000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic
    IsHalted: true
    enableTrustZone: true

nvic: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu }
}
    -> cpu@0

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

