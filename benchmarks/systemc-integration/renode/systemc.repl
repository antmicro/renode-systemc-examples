memory: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32i"
    timeProvider: empty
    IsHalted: true

controller: Miscellaneous.EmulatorController @ sysbus 0x0A000000

systemc: SystemC.SystemCPeripheral @ sysbus <0x09000000, +0x4000>
    timeSyncPeriodUS: 1000000000
    init:
        UseNative true
        DisableNativeDmi true
